# ── AEGIS Frontend — Environment Variables ───────────────────────────────────
# Copy to .env.local (gitignored) and adjust as needed.
# NEXT_PUBLIC_* variables are frozen at build time — changing them requires a rebuild.

# Backend base URL (Express + SSE). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# AegisVault address on BNB Chain Testnet (chainId 97).
# Latest deployment: 2h escrow timeout, two-step 24h oracle rotation,
# pause + emergency withdrawal, 1024 B reason limit.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10