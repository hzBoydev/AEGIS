# ── AEGIS Frontend — Environment Variables ───────────────────────────────────
# Copy ke .env.local (di-gitignore) lalu sesuaikan.
# Variabel NEXT_PUBLIC_* dibekukan saat build — ubah = build ulang.

# Base URL backend (Express + SSE). Tanpa slash di akhir.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Alamat AegisVault di BNB Chain Testnet (chainId 97).
# Deployment terbaru: escrow timeout 2 jam, oracle two-step 24 jam,
# pause + emergency withdrawal, batas reason 1024 B.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10
