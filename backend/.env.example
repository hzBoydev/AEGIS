# ── AEGIS Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.
#
# ⚠️ 3 variabel WAJIB diisi — backend langsung gagal start kalau kosong:
#     ORACLE_PRIVATE_KEY   ← private key wallet oracle (yang kirim tx on-chain)
#     CONTRACT_ADDRESS     ← alamat AegisVault yang di-deploy
#     RPC_URL              ← RPC BSC Testnet
# Contoh perintah start:  npm run dev   (butuh Ollama lokal, lihat OLLAMA_URL)
#
# Semua variabel di bawah punya nilai default aman — kecuali 3 di atas.

# ── Core ──────────────────────────────────────────────────────────────────────
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# AegisVault terbaru di BNB Chain Testnet
# (escrow timeout 2 jam, oracle two-step 24 jam, pause + emergency withdrawal)
CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10
ORACLE_PRIVATE_KEY=0xYOUR_ORACLE_PRIVATE_KEY

# Port HTTP API (default 3001)
PORT=3001
# Path SQLite (default aegis.db, relatif terhadap working directory)
DB_PATH=aegis.db

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL : debug | info | warn | error
# LOG_FORMAT: pretty (manusia) | json (mesin, untuk log aggregator)
LOG_LEVEL=info
LOG_FORMAT=pretty

# ── HTTP Security ─────────────────────────────────────────────────────────────
# Allowlist origin frontend (pisahkan koma). Default: localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Daftar address reviewer yang BOLEH mem-vote human review (pisahkan koma).
# Kosong = setiap address yang menandatangani pesan vote diterima (hanya untuk dev).
# Produksi: WAJIB diisi, contoh REVIEWER_ADDRESSES=0xabc...,0xdef...
REVIEWER_ADDRESSES=

# Token admin untuk POST /api/redteam (butuh Authorization: Bearer <token>).
# Kosong = token acak dibuat saat startup dan dicetak ke log.
#ADMIN_TOKEN=change-me-min-16-chars

# Jendela keabsahan signature vote (ms). Default 5 menit.
VOTE_MAX_AGE_MS=300000

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# Server inference lokal. OLLAMA_URL bisa diarahkan ke host lain
# (mis. http://gpu-box:11434) — jangan hardcode di kode.
# Tips demo: jalankan `ollama serve` + warmup model SEBELUM presentasi.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000

# Confidence threshold for LLM decisions (0.0 – 1.0).
# SYSTEM DESIGN HEURISTIC — not a calibrated statistical probability.
# LLM confidence < threshold → fail-safe REJECT (atau human review, lihat bawah).
LLM_CONFIDENCE_THRESHOLD=0.80

# Human-in-the-loop (Tier 2):
# conf < HUMAN_CONF_MIN → fail-safe REJECT (jangan tanya manusia untuk conf sampah).
# HUMAN_CONF_MIN <= conf < LLM_CONFIDENCE_THRESHOLD → hold on-chain, minta 1 suara manusia.
# Sidang berbalik lean Investigator→Judge (conf cukup tinggi) → juga minta manusia.
# Set HUMAN_ESCALATION_ENABLED=false untuk kembali ke fail-safe lama.
HUMAN_CONF_MIN=0.55
HUMAN_ESCALATION_ENABLED=true

# ── GoPlus Security Intelligence ─────────────────────────────────────────────
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1
# Optional: set for authenticated (higher rate limit) requests
GOPLUS_API_KEY=
GOPLUS_TIMEOUT_MS=5000

# ── GoPlus Demo Simulation (DEMO ONLY) ────────────────────────────────────────
# Default FALSE — GoPlus dipanggil apa adanya. Address testnet hampir pasti
# tidak punya riwayat di GoPlus, jadi untuk DEMO set true agar alur terlihat.
GOPLUS_SIMULATE=false
# Address tambahan (dipisah koma) yang ikut dianggap malicious saat simulasi aktif.
GOPLUS_SIMULATED_ADDRESSES=

# ── BscScan On-chain Intelligence (BSC Testnet, Chain ID 97) ─────────────────
BSCSCAN_API_URL=https://api-testnet.bscscan.com/api
# Get your API key at https://bscscan.com/myapikey
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY
BSCSCAN_TIMEOUT_MS=8000

# ── Rule Engine Security Parameters ──────────────────────────────────────────
# Wallet age threshold (days) for "new wallet" classification.
# MVP/hackathon parameter — adjust for production.
NEW_WALLET_DAYS=1

# Wallet with txCount <= this value is classified as "low-activity".
LOW_TX_COUNT_THRESHOLD=2

# Transfer amount threshold (BNB) for "significant transfer" classification.
# MVP/hackathon parameter. NOT a universal definition of "large".
# Transfer >= this to a new+low-activity wallet → REJECT.
SIGNIFICANT_TRANSFER_BNB=0.01

# Transfer >= this (BNB) to ANY address → eskalasi ke LLM (Rule 9).
VERY_LARGE_TRANSFER_BNB=1.0

# Kategori wallet "menengah": umur antara NEW_WALLET_DAYS dan nilai ini (hari).
MEDIUM_WALLET_DAYS=30

# Wallet menengah dengan txCount <= nilai ini dianggap low-activity (Rule 10).
MEDIUM_TX_THRESHOLD=10

# ── Oracle Polling ────────────────────────────────────────────────────────────
POLLING_INTERVAL_MS=8000

# Escrow yang gagal (RPC flake / timeout LLM) diulang otomatis dengan backoff.
# RETRY_MAX_ATTEMPTS=0 → matikan retry (perilaku lama: gagal = selesai).
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=30000
