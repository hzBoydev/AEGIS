# ── AEGIS Backend — Environment (lokal) ────────────────────────────────────────

# ── Core (wajib) ──────────────────────────────────────────────────────────────
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10
ORACLE_PRIVATE_KEY=

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EXPLAIN_TIMEOUT_MS=60000

# Panjang konteks Ollama. Harus >= jumlah token prompt+tool schema terbesar.
# Kalau kurang, model diam-diam memotong instruksi sistem.
OLLAMA_NUM_CTX=8192

# ── Multi-agent (native tool calling) ─────────────────────────────────────────
# true  = Investigator/Advocate memakai /api/chat + tool loop (9 tool read-only).
# false = jalur lama: needsData -> executeTools -> 1x follow-up.
# Profile "regresi" (tepat 4 panggilan LLM) = false + max steps 1 + advocate 0
# + followup 0 di bawah ini.
AGENT_NATIVE_TOOLS=true

# Batas putaran ReAct Investigator. Total panggilan investigator = maxSteps+1
# (putaran terakhir dijamin tanpa tool).
AGENT_MAX_STEPS=4

# Advocate berargumen posisi berlawanan, jadiOTTOMnya lebih kecil.
# 0 = satu panggilan, tanpa tool.
ADVOCATE_MAX_STEPS=2

# Batas keras jumlah tool yang boleh dieksekusi per agen.
AGENT_MAX_TOOL_CALLS=8

# Batas keras total panggilan LLM per escrow (Investigator + Advocate + Judge).
# 12 = 5 + 3 + 1 + re-pass 2 + Judge 1.
AGENT_MAX_LLM_CALLS=12

# Batas re-pass yang boleh terjadi setelah Judge #1 (default 1 langkah = 2 call).
# Set 0 untuk mematikan re-pass.
AGENT_MAX_FOLLOWUP_STEPS=1

# Batas karakter akumulated per prompt sebelum di-trim. Prompt yang melebihi ini
# akan dipotong dari pesan tertua, bukan ditolak.
AGENT_CONTEXT_CHAR_LIMIT=12000

# Batas address baru yang boleh ditambahkan ke scope query (dari hasil tool,
# mis. counterpart pada riwayat). Address hasil eksplorasi hanya "advisory" —
# tidak bisa menggantikan sender/recipient sebagai dasar override.
AGENT_MAX_DISCOVERED_ADDRESSES=5

# Timeout generik per panggilan LLM. Kalau kosong, diturunkan dari
# AGENT_LLM_CALL_ESTIMATE_MS * (AGENT_MAX_STEPS + 1). Hanya menghitung waktu
# di dalam lock Ollama, tidak menghitung antrean.
AGENT_LLM_CALL_ESTIMATE_MS=45000
# AGENT_TIMEOUT_MS=225000

# Simpan pelajaran dari koreksi manusia (veto/approve) agar Investigator pada
# escrow berikutnya bisa reuse. Pelajaran TIDAK PERNAH ditulis dari verdict AI.
AGENT_LESSONS_ENABLED=true

# ── Human-in-the-loop ─────────────────────────────────────────────────────────
LLM_CONFIDENCE_THRESHOLD=0.80
HUMAN_CONF_MIN=0.55
HUMAN_ESCALATION_ENABLED=true

# ── GoPlus (threat intel address) ─────────────────────────────────────────────
# 56 = BSC Mainnet, 97 = BSC Testnet. GoPlus membangun reputasinya dari mainnet,
# jadi kedua chain dicek lalu di-merge (flag di salah satu = malicious).
GOPLUS_CHAIN_IDS=56,97

# KOSONG = jalan anonymous (endpoint /address_security/{addr}?chain_id=).
# Boleh dipakai; hanya kena rate limit. Isi kalau demo rame / sering gagal.
# Dikirim sebagai header `Authorization: <key>` polos (tanpa awalan "Bearer ").
GOPLUS_API_KEY=

# MODE DEMO. Address ini hanya dipakai untuk menunjukkan jalur "GoPlus memblokir".
# Saat recipient cocok dengan GOPLUS_SIMULATED_ADDRESSES, checker short-circuit
# SEBELUM memanggil API GoPlus sama sekali, lalu Rule 1 di ruleEngine.ts menahan
# escrow sebagai REJECT dan Ollama TIDAK PERNAH dipanggil.
# Artinya: demo blokir = tolak instan tanpa multi-agent debate.
# Pakai address bersih untuk demo debate; pakai address di bawah untuk demo blokir.
GOPLUS_SIMULATE=true

# GoPlus menjawab CLEAN untuk address ini (semua flag "0").
# Jadi verdict "malicious" pada demo sepenuhnya berasal dari GOPLUS_SIMULATE,
# bukan threat intel asli. Hasilnya tetap ditandai simulated:true dan diberi
# label "(simulated)" di UI — jadi jangan diklaim sebagai deteksi GoPlus sungguhan.
GOPLUS_SIMULATED_ADDRESSES=

# ── BscScan — MATI di testnet ─────────────────────────────────────────────────
# Penggantinya (V2, chainid=97) hanya tersedia pada paket BERBAYAR.
# Efeknya bscscanChecker.ts selalu menerima null lalu turun ke fallback
# eth_getLogs via RPC. Semua variabel di bawah tidak berefek di testnet —
# disimpan hanya agar tidak hilang saat pindah ke mainnet.
BSCSCAN_API_URL=https://api-testnet.bscscan.com/api
BSCSCAN_API_KEY=QQMHDNZHZ1ZAREKI5DQ9WWDKXF7RT3W27K

# ── Rule engine ───────────────────────────────────────────────────────────────
# THRESHOLD PENTING (Rule 2 & 7): nilai di sini hanya menaikkan atau menurunkan
# SEVERITY sinyal yang dikirim ke Investigator — TIDAK pernah menambah/kurangi
# kemampuan menolak. Dana 0.05 BNB ke wallet kosong tetap butuh hearing; tidak ada
# nominal yang membuat wallet kosong otomatis ditolak.
SIGNIFICANT_TRANSFER_BNB=0.1

# Rule 9 (very large transfer): sinyal konteks, bukan penolakan.
VERY_LARGE_TRANSFER_BNB=1.0

# ── Address poisoning (Rule 14) ───────────────────────────────────────────────
# Lookalike poisoning harus cocok di KEDUA ujungnya: yang dilihat wallet/explorer.
# wallets memotong tengah, jadi cocok prefix saja = 1 dari 65536 kebetulan yang
# akan memblokir user yang jujur. Naikkan hanya kalau list counterparties kaya.
POISONING_PREFIX_CHARS=4
POISONING_SUFFIX_CHARS=4

# ── Sender drain pattern (Rule 18) ────────────────────────────────────────────
# Batas atas escrow yang dibuka SATU sender dalam jendela waktu ini.
SENDER_BURST_COUNT=3
SENDER_BURST_WINDOW_MIN=10

# ── Denylist lokal (Rule 12) ──────────────────────────────────────────────────
# Blocklist yang TIDAK bergantung pada GoPlus, jadi address yang sudah terblokir
# tetap tertahan saat API down. File di repo ini hanya seed yang dipelihara manual
# (tidak diunduh otomatis) — perbarui manual sebelum dipakai di produksi.
# File hilang / rusak / kosong = lookups mengembalikan null (UNKNOWN), BUKAN "aman".
DENYLIST_PATH=./data/denylist.json