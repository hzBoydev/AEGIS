# ── AEGIS Backend — Environment (lokal) ────────────────────────────────────────

# ── Core (wajib) ──────────────────────────────────────────────────────────────
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10
ORACLE_PRIVATE_KEY=

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EXPLAIN_TIMEOUT_MS=60000

# ── Human-in-the-loop ─────────────────────────────────────────────────────────
LLM_CONFIDENCE_THRESHOLD=0.80
HUMAN_CONF_MIN=0.55
HUMAN_ESCALATION_ENABLED=true

# ── GoPlus (threat intel address) ─────────────────────────────────────────────
# 56 = BSC Mainnet, 97 = BSC Testnet. GoPlus membangun reputasinya dari mainnet,
# jadi kedua chain dicek lalu di-merge (flag di salah satu = malicious).
GOPLUS_CHAIN_IDS=56,97

# KOSONG = jalan anonymous (endpoint /address_security/{addr}?chain_id=).
# Boleh dipakai; hanya kena rate limit. Isi kalau demo rame / sering gagal.
# Dikirim sebagai header `Authorization: <key>` polos (tanpa awalan "Bearer ").
GOPLUS_API_KEY=

# MODE DEMO. Address ini hanya dipakai untuk menunjukkan jalur "GoPlus memblokir".
# Saat recipient cocok dengan GOPLUS_SIMULATED_ADDRESSES, checker short-circuit
# SEBELUM memanggil API GoPlus sama sekali, lalu Rule 1 di ruleEngine.ts menahan
# escrow sebagai REJECT dan Ollama TIDAK PERNAH dipanggil.
# Artinya: demo blokir = tolak instan tanpa multi-agent debate.
# Pakai address bersih untuk demo debate; pakai address di bawah untuk demo blokir.
GOPLUS_SIMULATE=true

# GoPlus menjawab CLEAN untuk address ini (semua flag "0").
# Jadi verdict "malicious" pada demo sepenuhnya berasal dari GOPLUS_SIMULATE,
# bukan threat intel asli. Hasilnya tetap ditandai simulated:true dan diberi
# label "(simulated)" di UI — jadi jangan diklaim sebagai deteksi GoPlus sungguhan.
GOPLUS_SIMULATED_ADDRESSES=

# ── BscScan — MATI di testnet ─────────────────────────────────────────────────
# Penggantinya (V2, chainid=97) hanya tersedia pada paket BERBAYAR.
# Efeknya bscscanChecker.ts selalu menerima null lalu turun ke fallback
# eth_getLogs via RPC. Semua variabel di bawah tidak berefek di testnet —
# disimpan hanya agar tidak hilang saat pindah ke mainnet.
BSCSCAN_API_URL=https://api-testnet.bscscan.com/api
BSCSCAN_API_KEY=QQMHDNZHZ1ZAREKI5DQ9WWDKXF7RT3W27K

# ── Rule engine ───────────────────────────────────────────────────────────────
SIGNIFICANT_TRANSFER_BNB=0.01
VERY_LARGE_TRANSFER_BNB=1.0