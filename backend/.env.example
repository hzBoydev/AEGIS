# ── AEGIS Backend — Environment (local) ────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CONTRACT_ADDRESS=0xaCFCd2005578Aa407aFC3be7553Cad81baf58f10
ORACLE_PRIVATE_KEY=

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# localhost only works on your machine. When deploying (Railway, Docker, VPS) set
# this to a publicly reachable Ollama instance, or the debate pipeline has no LLM.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EXPLAIN_TIMEOUT_MS=60000

# Ollama context length. Must be >= the token count of the largest prompt + tool schema.
# If it is lower, the model silently truncates the system instructions.
OLLAMA_NUM_CTX=8192

# ── Multi-agent (native tool calling) ─────────────────────────────────────────
# true  = Investigator/Advocate use /api/chat + tool loop (9 read-only tools).
# false = legacy path: needsData -> executeTools -> 1x follow-up.
# The "regression" profile (exactly 4 LLM calls) = false + max steps 1
# + advocate 0 + followup 0 below.
AGENT_NATIVE_TOOLS=true

# ReAct loop cap for the Investigator. Total investigator calls = maxSteps+1
# (the last round is guaranteed to be tool-free).
AGENT_MAX_STEPS=4

# The Advocate argues for the opposite position, so its ceiling is smaller.
# 0 = a single call, no tools.
ADVOCATE_MAX_STEPS=2

# Hard cap on the number of tools that may be executed per agent.
AGENT_MAX_TOOL_CALLS=8

# Hard cap on the total number of LLM calls per escrow (Investigator + Advocate + Judge).
# 12 = 5 + 3 + 1 + re-pass 2 + Judge 1.
AGENT_MAX_LLM_CALLS=12

# Cap on re-passes allowed after Judge #1 (default 1 step = 2 calls).
# Set to 0 to disable re-passing.
AGENT_MAX_FOLLOWUP_STEPS=1

# Accumulated char cap per prompt before trimming. Prompts exceeding this are
# cut from the oldest message, not rejected.
AGENT_CONTEXT_CHAR_LIMIT=12000

# Cap on how many new addresses may be added to the query scope (from tool output,
# e.g. a counterpart in history). Explorer-discovered addresses are "advisory" only —
# they cannot replace the sender/recipient as the basis for an override.
AGENT_MAX_DISCOVERED_ADDRESSES=5

# Generic timeout per LLM call. When empty, it is derived from
# AGENT_LLM_CALL_ESTIMATE_MS * (AGENT_MAX_STEPS + 1). Only counts the time spent
# inside the Ollama lock, not queueing time.
AGENT_LLM_CALL_ESTIMATE_MS=45000
# AGENT_TIMEOUT_MS=225000

# Persist lessons from human corrections (veto/approve) so the Investigator on a
# later escrow can reuse them. Lessons are NEVER written from an AI verdict.
AGENT_LESSONS_ENABLED=true

# ── Human-in-the-loop ─────────────────────────────────────────────────────────
LLM_CONFIDENCE_THRESHOLD=0.80
HUMAN_CONF_MIN=0.55
HUMAN_ESCALATION_ENABLED=true

# ── GoPlus (address threat intel) ─────────────────────────────────────────────
# 56 = BSC Mainnet, 97 = BSC Testnet. GoPlus builds its reputation from mainnet,
# so both chains are checked and merged (a flag on either = malicious).
GOPLUS_CHAIN_IDS=56,97

# EMPTY = anonymous access (endpoint /address_security/{addr}?chain_id=).
# Fine to use; only rate-limited. Fill it in for a busy demo / frequent failures.
# Sent as a plain `Authorization: <key>` header (no "Bearer " prefix).
GOPLUS_API_KEY=

# DEMO MODE. This address is only used to show the "GoPlus blocks" path.
# When the recipient matches GOPLUS_SIMULATED_ADDRESSES, the checker short-circuits
# BEFORE calling the GoPlus API at all, then Rule 1 in ruleEngine.ts holds the
# escrow as REJECT and Ollama is NEVER called.
# That means: a block demo = instant reject without a multi-agent debate.
# Use a clean address for the debate demo; use the address below for the block demo.
GOPLUS_SIMULATE=true

# GoPlus answers CLEAN for this address (all flags "0").
# So a "malicious" verdict in the demo comes entirely from GOPLUS_SIMULATE,
# not real threat intel. The result is still marked simulated:true and labelled
# "(simulated)" in the UI — so do not claim it as genuine GoPlus detection.
GOPLUS_SIMULATED_ADDRESSES=

# ── BscScan — OFF on testnet ───────────────────────────────────────────────────
# Its replacement (V2, chainid=97) is only available on PAID plans.
# As a result bscscanChecker.ts always returns null and falls back to
# eth_getLogs via RPC. All variables below have no effect on testnet —
# they are kept only so nothing is lost when moving to mainnet.
BSCSCAN_API_URL=https://api-testnet.bscscan.com/api
BSCSCAN_API_KEY=QQMHDNZHZ1ZAREKI5DQ9WWDKXF7RT3W27K

# ── Rule engine ───────────────────────────────────────────────────────────────
# IMPORTANT THRESHOLD (Rule 2 & 7): the values here only raise or lower the
# SEVERITY of the signal sent to the Investigator — they never add or remove the
# ability to reject. A 0.05 BNB transfer to an empty wallet still requires a
# hearing; no amount makes an empty wallet automatically rejected.
SIGNIFICANT_TRANSFER_BNB=0.1

# Rule 9 (very large transfer): a context signal, not a rejection.
VERY_LARGE_TRANSFER_BNB=1.0

# ── Address poisoning (Rule 14) ───────────────────────────────────────────────
# Lookalike poisoning must match at BOTH ends: what the wallet/explorer shows.
# Wallets truncate the middle, so matching the prefix alone = a 1-in-65536
# coincidence that would block honest users. Raise these only if the counterparty
# list is rich.
POISONING_PREFIX_CHARS=4
POISONING_SUFFIX_CHARS=4

# ── Sender drain pattern (Rule 18) ────────────────────────────────────────────
# Upper bound on the escrows a SINGLE sender may open within this window.
SENDER_BURST_COUNT=3
SENDER_BURST_WINDOW_MIN=10

# ── Local denylist (Rule 12) ──────────────────────────────────────────────────
# A blocklist that does NOT depend on GoPlus, so already-blocked addresses stay
# held even when the API is down. The file in this repo is only a manually
# maintained seed (not downloaded automatically) — update it manually before
# using it in production. Missing / corrupted / empty file = lookups return
# null (UNKNOWN), NOT "safe".
DENYLIST_PATH=./data/denylist.json