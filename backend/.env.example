# ── AEGIS Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.

# ── Core ──────────────────────────────────────────────────────────────────────
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS
ORACLE_PRIVATE_KEY=0xYOUR_ORACLE_PRIVATE_KEY

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000

# Confidence threshold for LLM decisions (0.0 – 1.0).
# SYSTEM DESIGN HEURISTIC — not a calibrated statistical probability.
# LLM confidence < threshold → fail-safe REJECT.
LLM_CONFIDENCE_THRESHOLD=0.80

# ── GoPlus Security Intelligence ─────────────────────────────────────────────
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1
# Optional: set for authenticated (higher rate limit) requests
GOPLUS_API_KEY=
GOPLUS_TIMEOUT_MS=5000

# ── BscScan On-chain Intelligence (BSC Testnet, Chain ID 97) ─────────────────
BSCSCAN_API_URL=https://api-testnet.bscscan.com/api
# Get your API key at https://bscscan.com/myapikey
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY
BSCSCAN_TIMEOUT_MS=8000

# ── Rule Engine Security Parameters ──────────────────────────────────────────
# Wallet age threshold (days) for "new wallet" classification.
# MVP/hackathon parameter — adjust for production.
NEW_WALLET_DAYS=1

# Wallet with txCount <= this value is classified as "low-activity".
LOW_TX_COUNT_THRESHOLD=2

# Transfer amount threshold (BNB) for "significant transfer" classification.
# MVP/hackathon parameter. NOT a universal definition of "large".
# Transfer >= this to a new+low-activity wallet → REJECT.
SIGNIFICANT_TRANSFER_BNB=0.01

# ── Oracle Polling ────────────────────────────────────────────────────────────
POLLING_INTERVAL_MS=8000
